{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "es2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "$lib": ["src/lib"],
      "$lib/*": ["src/lib/*"],
      "@playwright/test": ["node_modules/@playwright/test"],
      "vitest": ["node_modules/vitest"],
      "@testing-library/svelte": ["node_modules/@testing-library/svelte"]
    },
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["vite/client"],
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts", "../../tests/web/**/*.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "src/routes", "src/svelte-lib", "src/lib/components/ui"],
  "extends": "./.svelte-kit/tsconfig.json"
}
