# Shared local configuration. Copy to deploy/docker/.env; never commit .env.
# Values below match the effective local defaults in deploy/docker/compose.yml and
# src/backend/polycolab/platform/config.py. Optional settings remain commented out.

# Compose and application identity
POLYCOLAB_POSTGRES_PORT=5432
APP_ENV=local
SERVICE_NAME=polycolab-api
SERVICE_VERSION=0.0.0
RELEASE_SHA=unknown
# Host-run API uses localhost; Compose overrides this with its private service address.
DATABASE_URL=postgresql+psycopg://polycolab:polycolab@localhost:5432/polycolab
# POLYCOLAB_COMPOSE_DATABASE_URL=postgresql+psycopg://polycolab:polycolab@postgres:5432/polycolab
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
POLYCOLAB_API_DATABASE_POOL_SIZE=5
POLYCOLAB_API_DATABASE_MAX_OVERFLOW=5
POLYCOLAB_API_DATABASE_POOL_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=["http://localhost:8000", "http://localhost:5173"]
LOG_LEVEL=INFO
# LOG_JSON= # unset; local mode resolves this to false

# Accounts, registration, and recovery
AUTH_MODE=local
# Required only while initializing an empty built-in-account database.
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
LOCAL_AUTH_SESSION_TTL_SECONDS=604800
LOCAL_AUTH_COOKIE_NAME=polycolab_session
REGISTRATION_MODE=closed
REGISTRATION_INVITATION_TTL_SECONDS=604800
REGISTRATION_REQUESTS_PER_MINUTE=5
LOGIN_ADDRESS_REQUESTS_PER_MINUTE=20
LOGIN_USERNAME_REQUESTS_PER_MINUTE=10
REGISTRATION_MAX_REQUEST_BYTES=4096
# Launchers supply a mode-specific origin when unset. Set an explicit value only
# when using a different browser URL (including direct api:dev or provider callbacks).
# PUBLIC_APP_ORIGIN=http://localhost:8000
ACCOUNT_RECOVERY_REAUTHENTICATION_SECONDS=300
ACCOUNT_RECOVERY_REQUESTS_PER_HOUR=5
MAIL_OUTBOX_LEASE_SECONDS=60
MAIL_OUTBOX_MAX_ATTEMPTS=8
MAIL_OUTBOX_RETRY_BASE_SECONDS=30

# Optional email delivery
# SMTP_HOST=localhost
SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=polycolab@localhost
SMTP_STARTTLS=true

# Optional direct social sign-in; configure each provider as a complete pair.
# SOCIAL_GOOGLE_CLIENT_ID=
# SOCIAL_GOOGLE_CLIENT_SECRET=
# SOCIAL_GITHUB_CLIENT_ID=
# SOCIAL_GITHUB_CLIENT_SECRET=
SOCIAL_AUTH_TRANSACTION_TTL_SECONDS=300
SOCIAL_LINK_REAUTHENTICATION_SECONDS=300

# Optional OIDC authentication; required values depend on AUTH_MODE=oidc.
# OIDC_ISSUER=https://identity.example
# OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
# OIDC_AUDIENCE=
# OIDC_AUTHORIZED_PARTY=
# OIDC_CLIENT_ID=
OIDC_CLOCK_SKEW_SECONDS=30

# Web application and API reference
WEB_DIST_DIR=/app/web-dist
# API_REFERENCE_ENABLED= # deprecated compatibility setting
# API_REFERENCE_ACCESS= # unset; local mode resolves this to public
API_REFERENCE_OPERATOR_SUBJECTS=[]

# Credential encryption
KMS_PROVIDER=local
# KMS_KEY_ID=
KMS_KEY_VERSION=v1
# KMS_REGION=
# OPENBAO_URL=
# OPENBAO_TOKEN=
OPENBAO_BACKEND_ID=primary
OPENBAO_MOUNT=transit
OPENBAO_KEY_NAME=gateway
OPENBAO_TRANSIT_VERSION=1
OPENBAO_HISTORICAL_TRANSIT_VERSIONS=[]
OPENBAO_ALLOW_LOOPBACK_HTTP=false
# LEGACY_AWS_KMS_KEY_ID=
# LEGACY_AWS_KMS_KEY_VERSION=
# LEGACY_AWS_KMS_REGION=
# Local encryption for agent API keys and model-provider credentials.
# Generate once: openssl rand -base64 32
# In deploy/docker/.env, uncomment the line below and paste the generated value
# after '='. This must decode to 32 random bytes; do not use a password.
# Keep the same value across restarts and back it up securely with deployment
# secrets. Replacing or losing it makes existing encrypted secrets unreadable.
# Never commit the real value. With no value configured, the local encryption
# key is temporary and encrypted secrets cannot be revealed after a restart.
# LOCAL_CREDENTIAL_MASTER_KEY=

# Model gateway
GATEWAY_RUN_TOKEN_TTL_SECONDS=300
GATEWAY_REQUEST_TIMEOUT_SECONDS=30
GATEWAY_MAX_OUTPUT_TOKENS=8192
GATEWAY_MAX_INPUT_BYTES=262144
GATEWAY_MAX_RESPONSE_BYTES=1000000
GATEWAY_RETRY_COUNT=1
GATEWAY_RETRY_BACKOFF_SECONDS=0.1
GATEWAY_INPUT_MICROUSD_PER_MILLION_TOKENS=10000000
GATEWAY_OUTPUT_MICROUSD_PER_MILLION_TOKENS=30000000
GATEWAY_MAX_COST_MICROUSD=1000000

# Built-in agent runtime
RUNTIME_LEASE_SECONDS=30
RUNTIME_MAX_ATTEMPTS=2
RUNTIME_MAX_MODEL_ROUNDS=4
# Set only when a compatible Linux hosted controller and pinned image are ready.
# RUNTIME_CODEX_IMAGE=registry.example/agent@sha256:<64-character-digest>
HOSTED_AGENT_CAPACITY=4
HOSTED_AGENT_USER_CAPACITY=2
HOSTED_AGENT_PROJECT_CAPACITY=2
RUNTIME_RUN_TIMEOUT_SECONDS=300
RUNTIME_SSE_POLL_SECONDS=0.25
RUNTIME_SSE_HEARTBEAT_SECONDS=15
RUNTIME_EVENT_BATCH_SIZE=100
# RUNTIME_INTERNAL_API_URL=http://core:8000 # fixed by Compose for the worker
RUNTIME_WORKER_ID=compose-builtin-worker
RUNTIME_WORKER_TOKEN=polycolab-local-runtime-worker-token
# Configure the previous token and expiry together during credential rotation.
# RUNTIME_WORKER_PREVIOUS_TOKEN=
# RUNTIME_WORKER_PREVIOUS_TOKEN_EXPIRES_AT=2026-09-11T12:00:00Z
RUNTIME_API_MAX_REQUEST_BYTES=400000
RUNTIME_API_MAX_RESPONSE_BYTES=1000000
RUNTIME_WORKER_POLL_SECONDS=0.25

# Moderation, agent credentials, and hosted execution
PUBLIC_PROJECT_MODERATOR_SUBJECTS=[]
EXTERNAL_AGENT_CREDENTIAL_TTL_SECONDS=2592000
EXTERNAL_AGENT_MAX_REQUESTS=10000
EXTERNAL_AGENT_MAX_MUTATIONS=1000
CATALOGUE_OPERATOR_SUBJECTS=[]
FEATURE_AGENT_EXECUTION_ENABLED=false

# Artifact storage (local Compose supplies Garage defaults; host-run APIs need all five values)
# ARTIFACT_S3_ENDPOINT=http://object-storage:3900
# ARTIFACT_S3_BUCKET=polycolab-artifacts
# ARTIFACT_S3_REGION=garage
# ARTIFACT_S3_ACCESS_KEY=
# ARTIFACT_S3_SECRET_KEY=
ARTIFACT_MAX_BYTES=16777216
ARTIFACT_REQUEST_TIMEOUT_SECONDS=30
ARTIFACT_STAGING_TTL_SECONDS=3600
ARTIFACT_GC_GRACE_SECONDS=300

# Verification service
FEATURE_VERIFICATION_SUBMISSION_ENABLED=false
FEATURE_VERIFICATION_EXECUTION_ENABLED=false
VERIFICATION_INTERNAL_API_URL=http://127.0.0.1:8000
VERIFICATION_CONTROLLER_ID=verification-controller
# VERIFICATION_CONTROLLER_TOKEN=
# Configure the previous token and expiry together during credential rotation.
# VERIFICATION_CONTROLLER_PREVIOUS_TOKEN=
# VERIFICATION_CONTROLLER_PREVIOUS_TOKEN_EXPIRES_AT=2026-09-11T12:00:00Z
VERIFICATION_QUEUE_CAPACITY=1000
VERIFICATION_USER_CONCURRENT_JOBS=2
VERIFICATION_PROJECT_CONCURRENT_JOBS=8
VERIFICATION_USER_DAILY_CPU_SECONDS=28800
VERIFICATION_PROJECT_DAILY_CPU_SECONDS=115200
VERIFICATION_USER_DAILY_MEMORY_BYTE_SECONDS=30923764531200
VERIFICATION_PROJECT_DAILY_MEMORY_BYTE_SECONDS=123695058124800
VERIFICATION_MAX_ATTEMPTS=2
VERIFICATION_LEASE_SECONDS=30
VERIFICATION_DEADLINE_SECONDS=3600
VERIFICATION_MANIFEST_MAX_INPUTS=128
VERIFICATION_EVENT_PAGE_SIZE=100
VERIFICATION_EVENT_PAYLOAD_BYTES=16384
VERIFICATION_DIAGNOSTIC_PAYLOAD_BYTES=65536
VERIFICATION_CONTROLLER_POLL_SECONDS=0.25
VERIFICATION_API_MAX_REQUEST_BYTES=262144
VERIFICATION_API_MAX_RESPONSE_BYTES=1000000

# Agent execution quotas
EXECUTION_USER_REQUESTS_PER_MINUTE=30
EXECUTION_PROJECT_REQUESTS_PER_MINUTE=120
EXECUTION_USER_CONCURRENT_RUNS=2
EXECUTION_PROJECT_CONCURRENT_RUNS=8
EXECUTION_USER_DAILY_TOKENS=10000000
EXECUTION_PROJECT_DAILY_TOKENS=100000000
EXECUTION_USER_DAILY_COST_MICROUSD=200000000
EXECUTION_PROJECT_DAILY_COST_MICROUSD=2000000000
EXECUTION_MAX_INPUT_TOKENS_PER_ROUND=262144
EXECUTION_RATE_WINDOW_RETENTION_MINUTES=120

# Admission and protected diagnostics
PUBLIC_READ_REQUESTS_PER_MINUTE=120
SSE_RECONNECTS_PER_MINUTE=30
# ADMISSION_SCOPE_HMAC_KEY=
ADMISSION_TRUSTED_PROXY_CIDRS=[]
OPERATOR_DIAGNOSTICS_ENABLED=false
OPERATOR_DIAGNOSTICS_SUBJECTS=[]

# Linear collaboration uses an internal sidecar.
COLLABORATION_URL=http://collaboration:8002
# Supply the same private 32+ character token to API and collaboration service.
COLLABORATION_TOKEN=
