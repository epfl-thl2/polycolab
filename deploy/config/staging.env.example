# Supply values through the deployment secret manager; do not store credentials here.
APP_ENV=staging
# Built-in accounts; initialize the fixed admin through the private bootstrap secret.
AUTH_MODE=local
# BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
REGISTRATION_MODE=closed
REGISTRATION_REQUESTS_PER_MINUTE=5
LOGIN_ADDRESS_REQUESTS_PER_MINUTE=20
LOGIN_USERNAME_REQUESTS_PER_MINUTE=10
REGISTRATION_MAX_REQUEST_BYTES=4096
REGISTRATION_INVITATION_TTL_SECONDS=604800
# Per process, not per deployment. Budget all replicas and rollout surge.
# Override serial community consumers to size 2 / overflow 0; see deploy/DATABASE-POOLS.md.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
# Optional organizational SSO: set AUTH_MODE=oidc and supply all four values.
# OIDC_ISSUER=https://REPLACE_WITH_OIDC_ISSUER
# OIDC_JWKS_URL=https://REPLACE_WITH_OIDC_JWKS_HOST/jwks.json
# OIDC_CLIENT_ID=REPLACE_WITH_PUBLIC_OIDC_CLIENT_ID
# OIDC_AUDIENCE=REPLACE_WITH_OIDC_AUDIENCE
# Optional direct sign-in alongside built-in passwords. Configure complete pairs
# through secret management and register the two exact callback paths.
# PUBLIC_APP_ORIGIN=https://staging.polycolab.example
# SOCIAL_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
# SOCIAL_GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# SOCIAL_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
# SOCIAL_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
DATABASE_URL=postgresql+psycopg://polycolab:REPLACE_WITH_SECRET@postgres.example:5432/polycolab
# Browser and API share one origin in deployed environments. Add origins only
# for an explicitly approved external API client.
ALLOWED_ORIGINS=[]
LOG_LEVEL=INFO
LOG_JSON=true
KMS_PROVIDER=aws
KMS_KEY_ID=REPLACE_WITH_AWS_KMS_KEY_ARN
KMS_REGION=REPLACE_WITH_AWS_REGION
KMS_KEY_VERSION=v1
GATEWAY_RUN_TOKEN_TTL_SECONDS=300
GATEWAY_REQUEST_TIMEOUT_SECONDS=30
GATEWAY_MAX_OUTPUT_TOKENS=8192
GATEWAY_MAX_INPUT_BYTES=262144
GATEWAY_MAX_RESPONSE_BYTES=1000000
GATEWAY_RETRY_COUNT=1
GATEWAY_RETRY_BACKOFF_SECONDS=0.1
# Conservative ceilings at or above the most expensive permitted model.
GATEWAY_INPUT_MICROUSD_PER_MILLION_TOKENS=10000000
GATEWAY_OUTPUT_MICROUSD_PER_MILLION_TOKENS=30000000
GATEWAY_MAX_COST_MICROUSD=1000000
RUNTIME_LEASE_SECONDS=30
RUNTIME_MAX_ATTEMPTS=2
RUNTIME_RUN_TIMEOUT_SECONDS=300
RUNTIME_WORKER_TOKEN=REPLACE_WITH_RANDOM_SECRET
# During rotation, the API alone receives the old token and its UTC deadline.
# RUNTIME_WORKER_PREVIOUS_TOKEN=REPLACE_WITH_PREVIOUS_SECRET
# RUNTIME_WORKER_PREVIOUS_TOKEN_EXPIRES_AT=2026-09-03T12:00:00Z
RUNTIME_API_MAX_REQUEST_BYTES=262144
RUNTIME_API_MAX_RESPONSE_BYTES=1000000
# Public-read address buckets use an HMAC key from the secret manager. List
# only direct ingress proxies that sanitize and overwrite X-Forwarded-For.
PUBLIC_READ_REQUESTS_PER_MINUTE=120
SSE_RECONNECTS_PER_MINUTE=30
ADMISSION_SCOPE_HMAC_KEY=REPLACE_WITH_SECRET
ADMISSION_TRUSTED_PROXY_CIDRS=[]

# Persistent API-owned Git volume; omit to disable workspace files.
WORKSPACE_REPOSITORY_DIRECTORY=/var/lib/polycolab/repositories
WORKSPACE_REPOSITORY_MAX_BYTES=67108864
