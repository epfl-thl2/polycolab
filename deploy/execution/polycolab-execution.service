[Unit]
Description=Polycolab hosted agent controller
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/polycolab/backend
ExecStart=/opt/polycolab/backend/.venv/bin/python -m polycolab.execution.service --config /etc/polycolab-execution/controller.toml
Restart=no
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
