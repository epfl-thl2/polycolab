{
  "name": "@polycolab/web",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "svelte-kit sync && vite",
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.svelte.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.svelte.json && tsc --noEmit --project tsconfig.tests.json",
    "test": "vitest run",
    "test:e2e": "playwright test --config ../tests/web/browser/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.41.0",
    "@polycolab/api-client": "workspace:*",
    "@polycolab/brand": "workspace:*",
    "@sveltejs/kit": "^2.70.3",
    "@tanstack/svelte-query": "^5.90.2",
    "@xyflow/svelte": "^1.6.6",
    "bits-ui": "^2.19.0",
    "clsx": "2.1.1",
    "elkjs": "^0.12.0",
    "katex": "0.16.22",
    "monaco-editor": "0.55.1",
    "oidc-client-ts": "3.3.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.57.0",
    "tailwind-merge": "3.5.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "4.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "27.0.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.1",
    "vitest": "4.1.11"
  },
  "type": "module"
}
