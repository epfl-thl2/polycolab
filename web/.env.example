# Zero-configuration local browser setup uses Vite's same-origin API proxy.
# Set VITE_API_BASE_URL only for a special test deployment with a separate API origin.
# VITE_API_BASE_URL=

# Enable only after the deployment has artifact storage and exact-publication gates.

# Optional public release metadata embedded at build time. The feedback link receives
# no research content automatically; configure an HTTPS, HTTP, mailto or local path.
# VITE_FEEDBACK_URL=https://example.org/polycolab-feedback
# VITE_RELEASE_ID=2026.09.14

# Server-side Vite proxy override for integration environments.
# POLYCOLAB_API_PROXY_TARGET=http://127.0.0.1:18000

# Deployed OIDC configuration is discovered from /auth/config. The browser uses
# Authorization Code + PKCE and refreshes tokens through the OIDC provider.
# Static access tokens are not supported.
